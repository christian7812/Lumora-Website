PORT=8000
BETTER_AUTH_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_EMAILS=admin@example.com
# Cloudinary credentials: keep the API secret only in Server/.env; never use it in VITE_* variables.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Arcjet security (rate limiting, bot detection, shield)
# Get your key at https://app.arcjet.com
ARCJET_KEY=ajkey_your_arcjet_key_here
ARCJET_ENV=development

# Paystack Payment Gateway (Ghana MoMo + Card)
# Get your keys at https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Telegram order notifications (configure in Render, never in frontend variables)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
